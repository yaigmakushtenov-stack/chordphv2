
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# BETTER AUTH
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# GOOGLE AUTH
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# CLOUDFLARE R2 (server-only; never prefix these with NEXT_PUBLIC_)
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET="your-r2-bucket-name"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"

# ABLY REALTIME (server-only; never prefix this with NEXT_PUBLIC_)
ABLY_API_KEY="replace-with-your-ably-api-key"

# TODO: FUTURE SOCIAL PROVIDERS (placeholders only; not enabled in src/lib/auth.ts)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
