generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MusicFileStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum UserRole {
  USER
  ADMIN
}

model BetterAuthUser {
  id               String              @id
  name             String
  email            String              @unique
  emailVerified    Boolean             @default(false)
  image            String?
  role             UserRole            @default(USER)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         BetterAuthSession[]
  accounts         BetterAuthAccount[]
  musicFiles       MusicFile[]
  tracks           Track[]
  setLists         SetList[]
  groupMemberships GroupMembership[]

  @@map("better_auth_users")
}

model Group {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        GroupMembership[]
  eventGroups        EventGroups[]
  eventGroupSetLists EventGroupSetList[]

  @@map("groups")
}

model GroupMembership {
  groupId   String
  userId    String
  role      GroupRole      @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, createdAt])
  @@index([groupId, role])
  @@map("group_memberships")
}

model BetterAuthSession {
  id        String         @id
  expiresAt DateTime
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("better_auth_sessions")
}

model BetterAuthAccount {
  id                    String         @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  BetterAuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("better_auth_accounts")
}

model BetterAuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("better_auth_verifications")
}

model MusicFile {
  id                   String          @id @default(cuid())
  ownerId              String
  sourceSha256         String          @db.Char(64)
  sourceHashVerifiedAt DateTime?
  objectKey            String          @unique
  storedSha256         String?         @db.Char(64)
  originalFileName     String
  contentType          String
  sourceSizeBytes      Int
  storedSizeBytes      Int?
  title                String?
  artist               String?
  album                String?
  status               MusicFileStatus @default(PENDING)
  metadata             Json            @default("{}")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  uploadedAt           DateTime?
  owner                BetterAuthUser  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  track                Track?

  @@index([ownerId, sourceSha256])
  @@index([ownerId, createdAt])
  @@index([ownerId, status])
  @@map("music_files")
}

enum VisibilityStatus {
  DRAFT
  PRIVATE
  PUBLIC
}

enum PublicityStatus {
  PRIVATE
  PENDING
  REJECTED
  APPROVED
}

model Track {
  id                String             @id @default(cuid())
  ownerId           String
  visibilityStatus  VisibilityStatus   @default(PRIVATE)
  publicityStatus   PublicityStatus    @default(PRIVATE)
  artistId          String?
  artistName        String
  musicFileId       String?            @unique
  title             String
  key               String
  capo              Int?
  tempo             Int?
  timeSignature     String?
  tuning            String
  youtubeLink       String?
  spotifyLink       String?
  tags              String[]           @default([])
  metadata          Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  owner             BetterAuthUser     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  artist            Artist?            @relation("PrimaryTrackArtist", fields: [artistId], references: [id], onDelete: SetNull)
  musicFile         MusicFile?         @relation(fields: [musicFileId], references: [id], onDelete: SetNull)
  annotation        TrackAnnotation?
  additionalArtists AdditionalArtist[]
  setListTracks     SetListTrack[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, visibilityStatus])
  @@index([artistId])
  @@index([visibilityStatus, updatedAt])
  @@index([publicityStatus, updatedAt])
  @@map("tracks")
}

enum TrackAnnotationType {
  VOCALS
  CHORDS
  TAB
  BASS
  DRUMS
}

model TrackAnnotation {
  id              String              @id @default(cuid())
  trackId         String              @unique
  lyricsAndChords String              @default("") @db.Text
  type            TrackAnnotationType @default(CHORDS)
  notes           String              @default("") @db.Text
  formatVersion   Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  track           Track               @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@map("track_annotations")
}

model Artist {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tracks    Track[]            @relation("PrimaryTrackArtist")
  credits   AdditionalArtist[]

  @@index([name])
  @@map("artists")
}

model AdditionalArtist {
  id         String   @id @default(cuid())
  trackId    String
  artistId   String
  joinPhrase String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId])
  @@index([artistId])
  @@map("additional_artists")
}

model Event {
  id                 String              @id @default(cuid())
  ownerId            String
  title              String
  description        String?
  startDate          DateTime
  place              String
  eventGroups        EventGroups[]
  eventGroupSetLists EventGroupSetList[]

  @@map("events")
}

model EventGroups {
  id          String   @id @default(cuid())
  description String?
  eventId     String
  groupId     String
  orderNumber Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId])
  @@map("event_groups")
}

model EventGroupSetList {
  id        String   @id @default(cuid())
  eventId   String
  groupId   String
  setListId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  setList   SetList  @relation(fields: [setListId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId, setListId])
  @@index([setListId])
  @@map("event_group_set_lists")
}

model SetList {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  ownerId            String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  owner              BetterAuthUser      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eventGroupSetLists EventGroupSetList[]
  tracks             SetListTrack[]

  @@index([ownerId, updatedAt])
  @@map("set_lists")
}

model SetListTrack {
  id          String   @id @default(cuid())
  setListId   String
  trackId     String
  orderNumber Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  settings    Json     @default("{}")
  setList     SetList  @relation(fields: [setListId], references: [id], onDelete: Cascade)
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([setListId, trackId])
  @@unique([setListId, orderNumber])
  @@index([trackId])
  @@map("set_list_tracks")
}
