{
  "appId": "com.chordph.app",
  "appName": "ChordPH",
  "webDir": "native-web",
  "loggingBehavior": "none",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["alert"]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  },
  "server": {
    "url": "https://chordph.vercel.app",
    "cleartext": false,
    "errorPath": "error.html"
  }
}
